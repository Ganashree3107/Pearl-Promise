# MongoDB Atlas or local MongoDB URI.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=pearl_promise

# Use a long random secret in every non-development environment.
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

FRONTEND_ORIGIN=http://localhost:5173
APP_NAME=Pearl Promise API
ENVIRONMENT=development
GOOGLE_CLIENT_ID=replace-with-your-google-oauth-web-client-id
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USERNAME=your-email-provider-username
EMAIL_PASSWORD=your-email-provider-password
EMAIL_FROM=no-reply@example.com
EMAIL_USE_TLS=true
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
